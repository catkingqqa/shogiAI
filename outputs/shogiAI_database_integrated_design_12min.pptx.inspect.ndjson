{"kind":"textbox","id":"sh/eloj2t83","slide":9,"text":"SELECT g.game_id, g.original_file_name,\n       bp.player_name AS black_player,\n       wp.player_name AS white_player,\n       g.event_name, g.opening, g.result,\n       (SELECT COUNT(1) FROM moves m\n        WHERE m.game_id = g.game_id) AS move_count\nFROM game_records g\nLEFT JOIN players bp ON g.black_player_id = bp.player_id\nLEFT JOIN players wp ON g.white_player_id = wp.player_id\nWHERE ...\nORDER BY g.played_at DESC, g.game_id DESC\nLIMIT ? OFFSET ?;","textPreview":"SELECT g.game_id, g.original_file_name, |        bp.player_name AS black_player, |        wp.player_name AS white_player, |        g.even...","textChars":451,"textLines":12,"bbox":[91,200,658,338]}
